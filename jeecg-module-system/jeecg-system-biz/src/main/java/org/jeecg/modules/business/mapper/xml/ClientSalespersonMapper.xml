<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.business.mapper.ClientSalespersonMapper">

    <delete id="deleteByClientId" parameterType="java.lang.String">
        DELETE
        FROM client_salesperson
        WHERE client_id = #{clientId}
    </delete>

    <select id="getSalespersonIdsByClientId" parameterType="java.lang.String" resultType="java.lang.String">
        SELECT salesperson_id
        FROM client_salesperson
        WHERE client_id = #{clientId}
    </select>
    <select id="getActiveClientIdsBySalespersonId" resultType="java.lang.String">
        SELECT id
        FROM client
        WHERE active = '1'
          AND id IN (
            SELECT client_id
            FROM client_salesperson
            WHERE salesperson_id = #{salespersonId}
        )
    </select>
    <select id="selectByClientIds" parameterType="java.util.List" resultType="org.jeecg.modules.business.entity.ClientSalesperson">
        SELECT id, client_id, salesperson_id
        FROM client_salesperson
        WHERE client_id IN
        <foreach collection="clientIds"
                 item="id"
                 open="("
                 close=")"
                 separator=",">
            #{id}
        </foreach>
    </select>

</mapper>