	/**
	 * 翻译 Excel 导入、导出中的 Popup 字典值。
	 */
	private <T> void translatePopupDict(List<T> dataList, String fieldName,
			String reportCode, String dictCode, String dictText, boolean strict) {
		if (dataList == null || dataList.isEmpty()) {
			return;
		}
		try {
			java.util.LinkedHashSet<String> keys = new java.util.LinkedHashSet<>();
			for (T item : dataList) {
				Object value = cn.hutool.core.util.ReflectUtil.getFieldValue(item, fieldName);
				if (value != null) {
					Arrays.stream(value.toString().split(",")).filter(oConvertUtils::isNotEmpty).forEach(keys::add);
				}
			}
			if (keys.isEmpty()) {
				return;
			}
			List<org.jeecg.common.system.vo.DictModel> options = sysBaseApi.queryPopupDictItems(
					reportCode, dictCode, dictText, strict ? "" : String.join(",", keys));
			Map<String, String> textMap = new HashMap<>();
			if (options != null) {
				for (org.jeecg.common.system.vo.DictModel option : options) {
					if (strict) {
						if (keys.contains(option.getText())) {
							textMap.putIfAbsent(option.getText(), option.getValue());
						}
						if (keys.contains(option.getValue())) {
							textMap.putIfAbsent(option.getValue(), option.getValue());
						}
					} else {
						textMap.put(option.getValue(), option.getText());
					}
				}
			}
			for (T item : dataList) {
				Object value = cn.hutool.core.util.ReflectUtil.getFieldValue(item, fieldName);
				if (value == null) {
					continue;
				}
				String translated = Arrays.stream(value.toString().split(",")).map(key -> {
					String text = textMap.get(key);
					if (strict && text == null) {
						throw new org.jeecg.common.exception.JeecgBootException(
								"Popup字典值不存在，字段：" + fieldName + "，值：" + key);
					}
					return text == null ? key : text;
				}).collect(Collectors.joining(","));
				cn.hutool.core.util.ReflectUtil.setFieldValue(item, fieldName, translated);
			}
		} catch (org.jeecg.common.exception.JeecgBootException e) {
			throw e;
		} catch (Exception e) {
			if (strict) {
				throw new org.jeecg.common.exception.JeecgBootException("Popup字典导入翻译失败，字段：" + fieldName, e);
			}
			log.warn("Popup字典导出翻译失败，字段：{}", fieldName, e);
		}
	}
</#if>
